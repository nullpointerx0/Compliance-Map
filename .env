# Database configuration
DATABASE_URL=sqlite:///./data/compliance.db

# Scraper configuration
# Set SCRAPER_MOCK=true to use saved static HTML snapshots under backend/app/scraper/snapshots/
SCRAPER_MOCK=true

# Entity resolution thresholds (Jaro-Winkler)
MATCH_THRESHOLD=0.85
AMBIGUOUS_THRESHOLD=0.60

# Delays for scraper (seconds)
RANDOM_DELAY_MIN=2.0
RANDOM_DELAY_MAX=5.0
